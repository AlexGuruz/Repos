# Copy to dashboard_sheets.env (same folder) and set your paths.
# File dashboard_sheets.env is gitignored (*.env).

# Required for Sheets API: path to GCP service account JSON (Stashbox / shared SA)
STASHBOX_SERVICE_ACCOUNT=E:/secrets/gcp/stashbox.json

# Optional: override default projection capital dashboard workbook
# PROJECTION_DASHBOARD_SPREADSHEET_ID=your_spreadsheet_id_here
