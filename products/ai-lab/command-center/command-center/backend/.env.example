# --- AI Lab governance ---
AI_LAB_ROOT=/mnt/workshop/Repos/products/ai-lab
AI_LAB_GOVERNANCE_ROOT=/mnt/workshop/Repos/products/ai-lab-governance
AI_LAB_MACHINE=main
AI_LAB_ENFORCEMENT=1

# --- Worker tunnels (WORKER_CURRENT.md) ---
# power-1: :8765 assistant, :5678 n8n (no Ollama)
# worker-node: :8766 / :5679 / GPU Ollama :11435
# Acheron local Ollama: :11434
WORKER_TUNNEL_URL=http://127.0.0.1:8765

# --- Hardware polling ---
NVIDIA_SMI_POLL_INTERVAL=5
# NVIDIA_SMI_PATH=/usr/bin/nvidia-smi

# --- Main model (optional - LM Studio / Ollama / etc.) ---
# Leave empty to use the intent-routing stub
MAIN_MODEL_URL=

# --- Repo paths to watch (colon-separated on Linux, semicolon on Windows) ---
WATCH_PATHS=/path/to/ai-lab/apps:/path/to/ai-lab/kylo

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Growflow Retail API (Command Center proxy) ---
# Default: local Growflow FastAPI on port 8791
# GROWFLOW_RETAIL_API_URL=http://127.0.0.1:8791

# --- Weather (Open-Meteo, no API key; optional) ---
# Default city when you do not say e.g. weather in Austin
# WEATHER_CITY=Chicago
# Or pin coordinates (skips geocoding):
# WEATHER_LAT=41.8781
# WEATHER_LON=-87.6298
# WEATHER_TEMP_UNIT=fahrenheit
