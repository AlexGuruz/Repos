*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.mdb

# Business / generated PDFs (invoices, etc.)
**/reports/invoices/*.pdf
scripts/invoices/*.pdf

# API keys & OAuth material
.env
.env.*
!.env.example
**/credentials.json
**/token.json
**/client_secret*.json
**/google-service-account*.json
*.pem
*.p12
*.pfx

# Heavy nested checkouts under ai-lab (separate clones / models)
ai-lab/Ai/

