{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Job",
  "description": "Task queue job (JOB-YYYYMMDD-NNNN)",
  "type": "object",
  "required": ["job_id", "created_at", "status"],
  "properties": {
    "job_id": { "type": "string", "pattern": "^JOB-[0-9]{8}-[0-9]{4}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pending", "running", "complete", "failed"] },
    "agent": { "type": "string" },
    "payload": { "type": "object" },
    "result_path": { "type": "string" },
    "error": { "type": "string" }
  }
}
