{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-lab-governance.local/schemas/catalog_bundle.schema.json",
  "title": "CatalogBundle",
  "description": "Wrapper for registry/components.yaml and registry/environments.yaml roots",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "type": "string" },
    "components": {
      "type": "array",
      "items": { "$ref": "component.schema.json" }
    },
    "environments": {
      "type": "array",
      "items": { "$ref": "environment.schema.json" }
    }
  }
}
