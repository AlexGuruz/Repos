# Minimal env for local-only boot (this machine only). Copy to .env if missing.
# Leave AI_LAB_GOVERNANCE_ROOT empty so the app starts without a governance repo.
AI_LAB_ENFORCEMENT=1
AI_LAB_MACHINE=main
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Optional: main brain LLM (LM Studio). Defaults below; set empty to disable model-backed chat.
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=Qwen2.5-Coder-14B-Instruct
