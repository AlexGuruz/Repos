{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DocSync Proposal",
  "description": "A single documentation update proposal generated by the DocSync agent.",
  "type": "object",
  "required": [
    "id", "trigger", "severity", "confidence",
    "title", "summary",
    "source_commit", "source_file", "source_author", "source_timestamp",
    "doc_targets", "proposed_diff", "needs_human_draft",
    "status", "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PROP-\\d{8}-[a-f0-9]{6}$",
      "description": "Unique ID: PROP-{yyyymmdd}-{6-char-hex}"
    },
    "trigger": {
      "type": "string",
      "enum": ["T1", "T2", "T3", "T4"],
      "description": "T1=symbol added/removed T2=signature changed T3=file moved T4=config key changed"
    },
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "WARN", "INFO"]
    },
    "confidence": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW"]
    },
    "review_required": {
      "type": "boolean",
      "default": false,
      "description": "True when confidence=MEDIUM — surfaces [needs-review] badge in UI"
    },
    "title": {
      "type": "string",
      "maxLength": 80,
      "description": "≤12 words, plain English"
    },
    "summary": {
      "type": "string",
      "maxLength": 500,
      "description": "≤3 sentences: what changed in code, why the doc is stale"
    },
    "source_commit": {
      "type": "string",
      "description": "Full 40-char git SHA"
    },
    "source_file": {
      "type": "string",
      "description": "Repo-relative path to the changed source file"
    },
    "source_author": {
      "type": "string"
    },
    "source_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "doc_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "section"],
        "properties": {
          "path":    { "type": "string", "description": "Repo-relative path to doc file" },
          "section": { "type": "string", "description": "Section heading or anchor within the doc, or 'full-file'" },
          "line_range": {
            "type": "array",
            "items": { "type": "integer" },
            "minItems": 2,
            "maxItems": 2,
            "description": "[start_line, end_line] of the stale content"
          }
        }
      }
    },
    "proposed_diff": {
      "type": ["string", "null"],
      "description": "Unified diff string (--- a/ +++ b/ format). Null if needs_human_draft=true"
    },
    "needs_human_draft": {
      "type": "boolean",
      "description": "True when agent cannot confidently generate the update"
    },
    "draft_hints": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "Bullet hints to guide human when needs_human_draft=true"
    },
    "batch": {
      "type": "boolean",
      "default": false,
      "description": "True when a single trigger cascades to many doc files (e.g. path rename)"
    },
    "batch_files": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "Additional doc paths beyond doc_targets when batch=true"
    },
    "drift_score": {
      "type": "number",
      "description": "Computed: severity_weight × trigger_count × age_factor"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "approved", "rejected", "deferred"],
      "default": "pending"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "type": ["object", "null"],
      "description": "Populated when status changes from pending",
      "properties": {
        "resolved_at":  { "type": "string", "format": "date-time" },
        "resolved_by":  { "type": "string" },
        "rationale":    { "type": "string", "description": "Human's reason for approve/reject/defer" },
        "defer_until":  { "type": ["string", "null"], "format": "date-time" },
        "applied_commit": {
          "type": ["string", "null"],
          "description": "Commit SHA where the doc update landed (approved only)"
        }
      }
    },
    "escalated": {
      "type": "boolean",
      "default": false,
      "description": "True when pending > 7 days with no decision"
    },
    "resurface_count": {
      "type": "integer",
      "default": 0,
      "description": "How many times a deferred proposal has been re-surfaced"
    }
  },
  "additionalProperties": false
}
